# ==============================================================================
# RYZORA Facebook Messenger AI Customer Service & Order Management System
# Environment Configuration Template (Use placeholders only, never real secrets)
# ==============================================================================

# Server Runtime
PORT=8080
NODE_ENV=production

# Meta for Developers (Facebook Messenger Platform)
# Obtained from developers.facebook.com -> App Dashboard
META_APP_ID=1268010728837960
META_APP_SECRET=YOUR_META_APP_SECRET
META_VERIFY_TOKEN=ryzora_messenger_verify_token_2026
META_PAGE_ID=1268010728837960
META_PAGE_ACCESS_TOKEN=YOUR_PERMANENT_PAGE_ACCESS_TOKEN

# Google Gemini API
# Configure via AI Studio Secrets panel or Google AI Studio API key
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-1.5-flash

# Supabase PostgreSQL Database
# Obtained from app.supabase.com -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Business Policies (Bangladesh)
DELIVERY_FEE_INSIDE_DHAKA=60
DELIVERY_FEE_OUTSIDE_DHAKA=120
FREE_DELIVERY_THRESHOLD=3000
